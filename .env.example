# SEC EDGAR Agent Configuration
# Copy this file to .env and fill in your values

# Runtime environment
# Use local/dev/test for development defaults. Use production in deployed environments.
ENVIRONMENT=local

# API key for protected API endpoints
# Production requires a non-default value.
API_KEY=sec-api-demo

# CORS origins for browser clients
# Local/dev/test default to wildcard CORS when this is blank.
# Production defaults to no allowed origins unless explicit origins are configured.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# OpenAI API Key (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# SEC EDGAR User Agent (required by SEC - use your email)
# Format: "AppName/Version (your@email.com)"
SEC_USER_AGENT="SECEdgarAgent/0.1.0 (your@email.com)"

# Optional: Default model for AI agent
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, gpt-4o-mini
OPENAI_MODEL=gpt-4o

# Optional: Cache settings
CACHE_TTL_SECONDS=1800
CACHE_DIR=./data/cache

# Optional: Vector store settings
CHROMA_PERSIST_DIR=./data/chroma

# Optional: Logging level
LOG_LEVEL=INFO
