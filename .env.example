# SEC EDGAR Agent Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (required for AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SEC EDGAR User Agent (required by SEC - use your email)
# Format: "AppName/Version (your@email.com)"
SEC_USER_AGENT="SECEdgarAgent/0.1.0 (your@email.com)"

# Optional: Default model for AI agent
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514
CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: Cache settings
CACHE_TTL_SECONDS=1800
CACHE_DIR=./data/cache

# Optional: Vector store settings
CHROMA_PERSIST_DIR=./data/chroma

# Optional: Logging level
LOG_LEVEL=INFO
